# Copiar como .env y ajustar según el entorno.
# En Railway (u otro hosting) estas variables se cargan desde el panel del servicio.

# Base de datos (SQLite / libSQL). Por defecto, un archivo local.
# En Railway, con un volumen montado en /data: file:/data/ced.db
# Para usar Turso: DATABASE_URL=libsql://<base>.turso.io y DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/ced.db
DATABASE_AUTH_TOKEN=

# Carpeta donde se guardan imágenes y materiales subidos desde el panel.
# En producción debe estar en un disco persistente (en Railway: /data/uploads).
UPLOADS_DIR=./data/uploads

# Dirección pública del sitio (necesaria detrás del HTTPS de un hosting).
# En Railway se detecta sola (RAILWAY_PUBLIC_DOMAIN); definila si usás un dominio propio.
SITE_URL=
# Dominios adicionales separados por coma (opcional).
ALLOWED_HOSTS=

# Primera cuenta administradora (sólo se usa si todavía no hay ningún administrador).
# Útil en hostings sin consola. Borrá ADMIN_PASSWORD después de ingresar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# Servidor en producción (npm start). En un hosting, HOST debe ser 0.0.0.0.
HOST=0.0.0.0
PORT=4321
