---
/* Tipografías autoalojadas (identidad provisional; ver src/styles/global.css). */
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource-variable/inter';
import '@fontsource/bebas-neue/400.css';
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Clase opcional en <body> para variantes de página (p. ej. INTERUCA). */
  bodyClass?: string;
}

const { title, description = site.descripcion, bodyClass } = Astro.props;
const fullTitle = title ? `${title} · ${site.nombre} UCA` : `${site.nombre} · UCA`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e1b33" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <!-- Sitio en desarrollo: no indexar hasta la publicación definitiva. -->
    <meta name="robots" content="noindex" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>

    <script>
      import '@/scripts/reveal';
      import '@/scripts/pending';
      import { autoInitFilters } from '@/scripts/filters';
      autoInitFilters();
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }

  .toast-region {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 200;
    width: min(calc(100% - 2rem), 440px);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .toast {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.15rem;
    background: var(--navy-900);
    color: var(--ivory);
    border-radius: var(--radius);
    border-left: 3px solid var(--gold-500);
    box-shadow: var(--shadow-lg);
    font-size: var(--fs-sm);
    line-height: 1.45;
    pointer-events: auto;
    animation: toast-in var(--dur) var(--ease-out);
  }
  .toast.is-leaving { animation: toast-out var(--dur) var(--ease-out) forwards; }
  .toast svg { flex: none; color: var(--gold-500); margin-top: 1px; }
  .toast strong { display: block; font-weight: 600; margin-bottom: 0.1rem; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(12px); } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(12px); } }
</style>
