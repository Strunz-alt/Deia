---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';

Astro.response.status = 403;
---

<BaseLayout title="Acceso restringido">
  <section class="section">
    <div class="container container--narrow denied">
      <span class="denied__icon"><Icon name="lock" size={34} /></span>
      <p class="eyebrow">Acceso restringido</p>
      <h1 class="h1">Esta sección es sólo para administradores</h1>
      <p class="lead">
        Tu cuenta no tiene permisos para ingresar al panel de administración. Si formás parte del equipo del Centro, pedile a un
        administrador que te habilite.
      </p>
      <div class="denied__actions">
        <a href="/" class="btn">Volver al inicio</a>
        <a href="/apuntes" class="btn btn--outline">Ir a los apuntes</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .denied { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
  .denied .lead { margin-inline: auto; }
  .denied__icon { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--red-50); color: var(--red-600); }
  .denied__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
</style>
