---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import NoticiaCard from '@/components/NoticiaCard.astro';
import Placeholder from '@/components/Placeholder.astro';
import SampleNotice from '@/components/SampleNotice.astro';
import { noticias } from '@/data/noticias';
import type { Noticia } from '@/data/types';
import { formatFecha, porFechaDesc } from '@/lib/format';

export function getStaticPaths() {
  return noticias.map((noticia) => ({ params: { slug: noticia.slug }, props: { noticia } }));
}

interface Props {
  noticia: Noticia;
}

const { noticia } = Astro.props;
const relacionadas = [...noticias]
  .filter((n) => n.slug !== noticia.slug)
  .sort((a, b) => Number(b.categoria === noticia.categoria) - Number(a.categoria === noticia.categoria) || porFechaDesc(a, b))
  .slice(0, 3);
const minutos = Math.max(1, Math.round(noticia.cuerpo.join(' ').split(/\s+/).length / 200));
---

<BaseLayout title={noticia.titulo} description={noticia.bajada}>
  <article>
    <header class="article-head">
      <div class="container container--narrow">
        <nav aria-label="Migas de pan" class="crumbs">
          <a href="/">Inicio</a> / <a href="/noticias">Noticias</a> / <span aria-current="page">{noticia.categoria}</span>
        </nav>
        <div class="article-head__meta" data-reveal>
          <a href={`/noticias?categoria=${encodeURIComponent(noticia.categoria)}`} class="badge badge--navy">{noticia.categoria}</a>
          {noticia.ejemplo && <span class="badge badge--sample">Ejemplo</span>}
        </div>
        <h1 class="h1 article-head__title" data-reveal>{noticia.titulo}</h1>
        <p class="lead article-head__lead" data-reveal>{noticia.bajada}</p>
        <div class="article-head__byline" data-reveal>
          <span><Icon name="calendar" size={16} /><time datetime={noticia.fecha}>{formatFecha(noticia.fecha)}</time></span>
          <span><Icon name="clock" size={16} />{minutos} min de lectura</span>
          <button type="button" class="share" data-share>
            <Icon name="link" size={16} /> <span data-share-label>Copiar enlace</span>
          </button>
        </div>
      </div>
    </header>

    <div class="container article-media" data-reveal>
      <Placeholder image={noticia.imagen} icon="image" ratio="21 / 9" label="Imagen principal pendiente" />
    </div>

    <div class="container container--narrow section--tight article-body">
      {noticia.ejemplo && <SampleNotice source="src/data/noticias.ts" />}
      <div class="prose">
        {noticia.cuerpo.map((p) => <p>{p}</p>)}
      </div>
      <a href="/noticias" class="link-arrow back"><Icon name="arrow-left" size={16} /> Volver a noticias</a>
    </div>
  </article>

  {
    relacionadas.length > 0 && (
      <section class="section section--sand section--tight" aria-labelledby="rel-title">
        <div class="container">
          <h2 class="h2" id="rel-title" style="margin-bottom:2rem">Seguí leyendo</h2>
          <div class="grid grid--3" data-reveal-stagger>
            {relacionadas.map((n) => (
              <NoticiaCard noticia={n} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .article-head { padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem); }
  .crumbs { font-size: var(--fs-xs); color: var(--ink-soft); }
  .crumbs a:hover { color: var(--gold-600); text-decoration: underline; text-underline-offset: 3px; }
  .article-head__meta { display: flex; gap: 0.5rem; margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .article-head__meta a.badge:hover { background: var(--navy-700); }
  .article-head__title { margin-top: 1.25rem; }
  .article-head__lead { margin-top: 1.25rem; font-size: var(--fs-lg); font-family: var(--font-serif); font-style: italic; color: var(--ink-soft); line-height: 1.4; }
  .article-head__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .article-head__byline > span { display: inline-flex; gap: 0.45rem; align-items: center; }
  .article-head__byline :global(.icon) { color: var(--gold-600); }
  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 600;
    transition: background-color var(--dur-fast), border-color var(--dur-fast);
  }
  .share:hover { border-color: var(--navy-900); background: var(--paper); }
  .article-media :global(.ph), .article-media :global(img) { border-radius: var(--radius-lg); }
  .article-body { padding-bottom: var(--space-section); }
  .back { margin-top: 3rem; }
</style>

<script>
  import { showToast } from '@/scripts/pending';

  // Copia el enlace real de la noticia al portapapeles.
  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.querySelector('[data-share-label]')!;
    try {
      await navigator.clipboard.writeText(location.href);
      label.textContent = 'Enlace copiado';
      setTimeout(() => (label.textContent = 'Copiar enlace'), 2500);
    } catch {
      showToast('No se pudo copiar automáticamente. Copiá la dirección desde la barra del navegador.', 'No se pudo copiar');
    }
  });
</script>
