---
/**
 * Biblioteca de resúmenes y apuntes.
 * - Visitantes: ven las materias disponibles y se les pide iniciar sesión.
 * - Usuarios con sesión: listado completo con buscador, filtros y descargas.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import MaterialCard from '@/components/MaterialCard.astro';
import PageHero from '@/components/PageHero.astro';
import Placeholder from '@/components/Placeholder.astro';
import { TIPOS_MATERIAL } from '@/db/schema';
import { listAllCatedras, listMateriales, listMaterias } from '@/lib/services/materias';

const user = Astro.locals.user;
const materias = await listMaterias();
const totalMateriales = materias.reduce((n, m) => n + Number(m.materiales), 0);
const next = encodeURIComponent(Astro.url.pathname + Astro.url.search);

const materiales = user ? await listMateriales() : [];
const catedras = user ? await listAllCatedras() : [];
const anios = [...new Set(materias.map((m) => m.anio).filter((a): a is number => a !== null))].sort();
const tipos = TIPOS_MATERIAL.filter((t) => materiales.some((m) => m.tipo === t));
const materiasConMaterial = materias.filter((m) => Number(m.materiales) > 0);
---

<BaseLayout title="Resúmenes y apuntes" description="Biblioteca de resúmenes y apuntes de la Facultad de Derecho de la UCA, organizada por materia, cátedra y año.">
  <PageHero
    eyebrow="Biblioteca del Centro"
    title="Resúmenes y apuntes"
    lead="Material de estudio organizado por materia, cátedra y año de la carrera. Buscá, filtrá y descargá lo que necesitás para tu próxima cursada o examen."
  >
    <ul role="list" class="lib-stats">
      <li><strong>{totalMateriales}</strong> materiales</li>
      <li><strong>{materias.length}</strong> materias</li>
    </ul>
  </PageHero>

  {
    !user ? (
      <section class="section section--tight">
        <div class="container">
          <div class="gate" data-reveal>
            <span class="gate__icon"><Icon name="lock" size={30} /></span>
            <div class="gate__text">
              <h2 class="h2">Ingresá para acceder a los materiales</h2>
              <p class="lead">
                Los resúmenes y apuntes están disponibles para estudiantes con cuenta. Registrarte es gratis y lleva un minuto.
              </p>
            </div>
            <div class="gate__actions">
              <a href={`/ingresar?next=${next}`} class="btn"><Icon name="user" /> Ingresar</a>
              <a href={`/registro?next=${next}`} class="btn btn--outline">Crear cuenta</a>
            </div>
          </div>

          {materias.length > 0 && (
            <>
              <h2 class="h2 materias-title" data-reveal>Materias disponibles</h2>
              <ul role="list" class="materias" data-reveal-stagger>
                {materias.map((m) => (
                  <li class="materia">
                    <Placeholder src={m.imagen} alt="" ratio="4 / 3" tone="red" />
                    <div class="materia__body">
                      {m.anio && <span class="materia__anio">{m.anio}.º año</span>}
                      <h3 class="materia__name">{m.nombre}</h3>
                      <p class="materia__count">
                        {m.materiales} {Number(m.materiales) === 1 ? 'material' : 'materiales'} · {m.catedras} {Number(m.catedras) === 1 ? 'cátedra' : 'cátedras'}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </section>
    ) : (
      <section class="section section--tight">
        <div class="container" data-filter-root data-filter-manual id="biblioteca">
          {materiales.length === 0 ? (
            <EmptyState icon="book" title="La biblioteca todavía está vacía" text="Pronto vamos a publicar los primeros resúmenes y apuntes." />
          ) : (
            <div class="library">
              <aside class="filters" aria-label="Filtros de la biblioteca">
                <div class="filters__head">
                  <h2 class="filters__title"><Icon name="filter" size={18} /> Filtros</h2>
                  <button type="button" class="reset" data-filter-reset>Limpiar</button>
                </div>
                {anios.length > 0 && (
                  <div class="field">
                    <label class="field__label" for="f-anio">Año de la carrera</label>
                    <select id="f-anio" class="select" data-filter-key="anio">
                      <option value="">Todos los años</option>
                      {anios.map((a) => <option value={String(a)}>{a}.º año</option>)}
                    </select>
                  </div>
                )}
                <div class="field">
                  <label class="field__label" for="f-materia">Materia</label>
                  <select id="f-materia" class="select" data-filter-key="materia">
                    <option value="">Todas las materias</option>
                    {materiasConMaterial.map((m) => <option value={String(m.id)} data-anio={m.anio ?? ''}>{m.nombre}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label class="field__label" for="f-catedra">Cátedra</label>
                  <select id="f-catedra" class="select" data-filter-key="catedra">
                    <option value="">Todas las cátedras</option>
                    <option value="general">General (sin cátedra)</option>
                    {catedras.map((c) => <option value={String(c.id)} data-materia={String(c.materiaId)}>{c.nombre}</option>)}
                  </select>
                  <p class="field__hint" id="f-catedra-hint">Elegí una materia para ver sus cátedras.</p>
                </div>
                {tipos.length > 1 && (
                  <div class="field">
                    <label class="field__label" for="f-tipo">Tipo de material</label>
                    <select id="f-tipo" class="select" data-filter-key="tipo">
                      <option value="">Todos los tipos</option>
                      {tipos.map((t) => <option value={t}>{t}</option>)}
                    </select>
                  </div>
                )}
              </aside>

              <div class="library__main">
                <div class="searchbar">
                  <label for="lib-q" class="visually-hidden">Buscar en la biblioteca</label>
                  <Icon name="search" size={20} />
                  <input id="lib-q" type="search" placeholder="Buscar por título, materia o cátedra…" data-filter-search autocomplete="off" />
                  <kbd class="searchbar__kbd" aria-hidden="true">/</kbd>
                </div>

                <div class="results-bar">
                  <p class="results-bar__count" data-filter-count data-one="material" data-many="materiales" aria-live="polite"></p>
                  <div class="results-bar__tools">
                    <label class="sort">
                      <span class="visually-hidden">Ordenar</span>
                      <select class="select select--sm" data-sort>
                        <option value="recientes">Más recientes</option>
                        <option value="materia">Materia (A–Z)</option>
                        <option value="anio">Año de la carrera</option>
                      </select>
                    </label>
                    <div class="view-toggle" role="group" aria-label="Vista">
                      <button type="button" aria-pressed="true" data-view-btn="grid" aria-label="Vista en cuadrícula" title="Cuadrícula"><Icon name="grid" size={18} /></button>
                      <button type="button" aria-pressed="false" data-view-btn="list" aria-label="Vista en lista" title="Lista"><Icon name="list" size={18} /></button>
                    </div>
                  </div>
                </div>

                <div class="active-filters" data-active-filters aria-live="polite"></div>

                <div class="lib-grid" data-view="grid" data-lib-list>
                  {materiales.map((m) => (
                    <MaterialCard material={m} />
                  ))}
                </div>
                <EmptyState filterEmpty icon="search" title="No encontramos materiales" text="No hay resultados para esa combinación. Probá con otro término o quitá algún filtro.">
                  <button type="button" class="btn btn--outline btn--sm" data-filter-reset>Limpiar filtros</button>
                </EmptyState>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import { initFilters } from '@/scripts/filters';

  const root = document.querySelector<HTMLElement>('#biblioteca');
  if (root && root.querySelector('[data-lib-list]')) {
    const materia = root.querySelector<HTMLSelectElement>('#f-materia')!;
    const catedra = root.querySelector<HTMLSelectElement>('#f-catedra')!;
    const anio = root.querySelector<HTMLSelectElement>('#f-anio');
    const hint = root.querySelector<HTMLElement>('#f-catedra-hint');
    const list = root.querySelector<HTMLElement>('[data-lib-list]')!;
    const chipsBox = root.querySelector<HTMLElement>('[data-active-filters]')!;

    /** Materias según el año elegido y cátedras según la materia. */
    const syncDependents = () => {
      [...materia.options].forEach((o) => {
        if (!o.value) return;
        const ok = !anio?.value || o.dataset.anio === anio.value;
        o.hidden = !ok;
        o.disabled = !ok;
      });
      if (materia.selectedOptions[0]?.disabled) materia.value = '';
      [...catedra.options].forEach((o) => {
        if (!o.value || o.value === 'general') return;
        const ok = Boolean(materia.value) && o.dataset.materia === materia.value;
        o.hidden = !ok;
        o.disabled = !ok;
      });
      if (catedra.selectedOptions[0]?.disabled) catedra.value = '';
      if (hint) hint.hidden = Boolean(materia.value);
    };

    const labels: Record<string, string> = { anio: 'Año', materia: 'Materia', catedra: 'Cátedra', tipo: 'Tipo' };
    const optionText = (key: string, value: string) =>
      root.querySelector<HTMLSelectElement>(`select[data-filter-key="${key}"]`)?.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(value)}"]`)?.textContent ?? value;

    const renderActive = (state: { q: string; values: Record<string, string> }) => {
      chipsBox.innerHTML = '';
      const entries = Object.entries(state.values).filter(([, v]) => v);
      if (state.q) entries.unshift(['q', state.q]);
      entries.forEach(([key, value]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'active-chip';
        b.innerHTML = '<span></span><span aria-hidden="true">×</span>';
        b.firstElementChild!.textContent = key === 'q' ? `Búsqueda: “${value}”` : `${labels[key]}: ${optionText(key, value)}`;
        b.setAttribute('aria-label', `Quitar filtro ${key === 'q' ? 'de búsqueda' : labels[key]}`);
        b.addEventListener('click', () => {
          if (key === 'q') root.querySelector<HTMLInputElement>('[data-filter-search]')!.value = '';
          else root.querySelector<HTMLSelectElement>(`select[data-filter-key="${key}"]`)!.value = '';
          syncDependents();
          filters.apply();
        });
        chipsBox.append(b);
      });
    };

    [anio, materia].forEach((s) => s?.addEventListener('change', syncDependents, { capture: true }));
    syncDependents();
    const filters = initFilters(root, renderActive);
    syncDependents();
    filters.apply();
    root.querySelectorAll('[data-filter-reset]').forEach((r) => r.addEventListener('click', syncDependents));

    // Orden
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    sortSelect.addEventListener('change', () => {
      const items = [...list.querySelectorAll<HTMLElement>('[data-filter-item]')];
      const cmp: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        recientes: (a, b) => (b.dataset.fecha ?? '').localeCompare(a.dataset.fecha ?? ''),
        materia: (a, b) => (a.dataset.ordenMateria ?? '').localeCompare(b.dataset.ordenMateria ?? '', 'es'),
        anio: (a, b) => Number(a.dataset.fAnio || 99) - Number(b.dataset.fAnio || 99) || (a.dataset.ordenMateria ?? '').localeCompare(b.dataset.ordenMateria ?? '', 'es'),
      };
      items.sort(cmp[sortSelect.value]).forEach((el) => list.append(el));
    });

    // Vista cuadrícula / lista (se recuerda en este navegador)
    const viewBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
    const setView = (v: string) => {
      list.setAttribute('data-view', v);
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v)));
      try {
        localStorage.setItem('apuntes-view', v);
      } catch {
        /* sin almacenamiento */
      }
    };
    viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn!)));
    try {
      const saved = localStorage.getItem('apuntes-view');
      if (saved === 'list' || saved === 'grid') setView(saved);
    } catch {
      /* sin almacenamiento */
    }

    // Atajo "/" para enfocar el buscador
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]')!;
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === '/' && !['INPUT', 'SELECT', 'TEXTAREA'].includes(t.tagName)) {
        e.preventDefault();
        search.focus();
      }
    });
  }
</script>

<style>
  .lib-stats { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 1.75rem !important; font-size: var(--fs-sm); font-weight: 600; color: #fbe3e0; }
  .lib-stats strong { font-family: var(--font-display); font-size: 2.4rem; font-weight: 400; color: var(--white); margin-right: 0.35rem; }

  .gate {
    display: grid;
    gap: 1.25rem 2rem;
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 6px solid var(--red-600);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  @media (min-width: 900px) { .gate { grid-template-columns: auto 1fr auto; } }
  .gate__icon { display: grid; place-items: center; width: 68px; height: 68px; border-radius: 50%; background: var(--red-600); color: var(--white); }
  .gate__text > * + * { margin-top: 0.5rem; }
  .gate__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .materias-title { margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 1.5rem; }
  .materias { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .materia { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--white); border: 1px solid var(--line); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .materia:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .materia__body { padding: 1rem 1.1rem 1.2rem; }
  .materia__anio { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-600); }
  .materia__name { font-family: var(--font-cond); font-size: 1.25rem; font-weight: 500; line-height: 1.2; margin-top: 0.2rem; }
  .materia__count { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: 0.3rem; }

  .library { display: grid; gap: 2rem; }
  @media (min-width: 1000px) {
    .library { grid-template-columns: 270px 1fr; gap: 3rem; align-items: start; }
    .filters { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .filters { display: grid; gap: 1.1rem; padding: 1.4rem; background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--red-600); border-radius: var(--radius); }
  .filters__head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .filters__title { display: flex; align-items: center; gap: 0.5rem; font-size: var(--fs-sm); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .filters__title :global(.icon) { color: var(--red-600); }
  @media (max-width: 999px) {
    .filters { grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
    .filters__head { grid-column: 1 / -1; }
  }

  .searchbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.1rem;
    min-height: 58px;
    background: var(--white);
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-faint);
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .searchbar:focus-within { border-color: var(--red-600); box-shadow: 0 0 0 3px rgb(171 23 23 / 0.15); }
  .searchbar input { flex: 1; min-width: 0; border: 0; background: none; font-size: var(--fs-md); color: var(--ink); padding: 0.75rem 0; }
  .searchbar input:focus { outline: none; }
  .searchbar__kbd { font-family: var(--font-sans); font-size: var(--fs-xs); padding: 0.1rem 0.45rem; border: 1px solid var(--line-strong); border-radius: 4px; }

  .results-bar__tools { display: flex; align-items: center; gap: 0.6rem; }
  .select--sm { min-height: 38px; padding-block: 0.35rem; font-size: var(--fs-sm); }
  .view-toggle { display: flex; border: 1px solid var(--line-strong); border-radius: 6px; overflow: hidden; }
  .view-toggle button { display: grid; place-items: center; width: 38px; height: 36px; color: var(--ink-soft); transition: background-color var(--dur-fast), color var(--dur-fast); }
  .view-toggle button:hover { background: var(--sand); }
  .view-toggle button[aria-pressed='true'] { background: var(--red-600); color: var(--white); }
  @media (max-width: 560px) {
    .results-bar { flex-wrap: wrap; }
    .view-toggle { display: none; }
  }

  .active-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .active-filters:empty { display: none; }
  .active-filters :global(.active-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem 0.3rem 0.85rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    border-radius: 999px;
    background: var(--red-50);
    color: var(--red-700);
    border: 1px solid var(--red-100);
    transition: background-color var(--dur-fast);
  }
  .active-filters :global(.active-chip:hover) { background: var(--red-100); }
  .active-filters :global(.active-chip span:last-child) { font-size: 1rem; line-height: 1; }

  .lib-grid { display: grid; gap: 1rem; }
  .lib-grid[data-view='grid'] { grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
</style>
