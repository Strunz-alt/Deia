---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="section nf">
    <div class="container container--narrow nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <p class="eyebrow">Página no encontrada</p>
      <h1 class="h1">No encontramos lo que buscabas</h1>
      <p class="lead">Es posible que la página se haya movido o que todavía no esté publicada.</p>
      <div class="nf__actions">
        <a href="/" class="btn"><Icon name="arrow-left" /> Volver al inicio</a>
        <a href="/apuntes" class="btn btn--outline">Resúmenes y apuntes</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .nf__code { font-family: var(--font-serif); font-style: italic; font-size: clamp(6rem, 4rem + 10vw, 11rem); line-height: 0.9; color: var(--gold-500); }
  .nf__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
</style>
