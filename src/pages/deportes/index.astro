---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import DateStamp from '@/components/DateStamp.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import SampleNotice from '@/components/SampleNotice.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { actividadesDeportivas, disciplinas, interuca } from '@/data/deportes';
import { estadoEvento, porFechaAsc } from '@/lib/format';

const proximas = actividadesDeportivas.filter((a) => estadoEvento(a.fecha) === 'proxima').sort(porFechaAsc);
const podios = interuca.flatMap((e) => e.resultados).filter((r) => r.posicion !== null).length;
const ediciones = interuca.length;
---

<BaseLayout title="Deportes" description="Disciplinas, entrenamientos y competencias del Centro de Estudiantes de Derecho de la UCA.">
  <PageHero
    eyebrow="Deporte y comunidad"
    title="Deportes"
    lead="Entrenamos, competimos y representamos a la Facultad. Conocé las disciplinas, los horarios de entrenamiento y cómo sumarte a los equipos."
    crumbs={[{ label: 'Actividades' }]}
    numeral="IV"
  />

  <!-- Acceso destacado INTERUCA -->
  <section class="section section--tight">
    <div class="container">
      <a href="/deportes/interuca" class="iu-banner" data-reveal>
        <div class="iu-banner__text">
          <span class="iu-banner__kicker"><Icon name="trophy" size={18} /> Historial de victorias</span>
          <span class="iu-banner__title">INTERUCA</span>
          <span class="iu-banner__lead">Resultados, trofeos, fotos e hitos de cada edición, por año y disciplina.</span>
        </div>
        <div class="iu-banner__stats" aria-hidden="true">
          <span><strong>{ediciones}</strong> ediciones</span>
          <span><strong>{podios}</strong> podios</span>
        </div>
        <span class="iu-banner__cta">Ver historial <Icon name="arrow" size={20} /></span>
      </a>
    </div>
  </section>

  <!-- Disciplinas -->
  <section class="section section--tight" aria-labelledby="disc-title">
    <div class="container">
      <SectionHeader
        id="disc-title"
        eyebrow="Disciplinas"
        title="Elegí tu deporte"
        lead="Entrenamientos semanales y competencias durante todo el año. Los horarios definitivos se publican al inicio de cada cuatrimestre."
      />
      <SampleNotice source="src/data/deportes.ts" text="Las disciplinas, horarios y actividades son de ejemplo: confirmar con el área de Deportes." />
      {
        disciplinas.length > 0 ? (
          <div class="grid grid--3" data-reveal-stagger>
            {disciplinas.map((d) => (
              <article class="card card--interactive disc" id={d.slug}>
                <div class="disc__head">
                  <span class="disc__icon"><Icon name="ball" size={24} /></span>
                  <h3 class="disc__name">{d.nombre}</h3>
                  {d.ejemplo && <span class="badge badge--sample">Ejemplo</span>}
                </div>
                <div class="card__body">
                  <div class="card__meta">
                    {d.ramas.map((r) => (
                      <span class="badge">{r}</span>
                    ))}
                  </div>
                  <div class="disc__block">
                    <p class="disc__label">Entrenamientos</p>
                    <ul role="list" class="disc__list">
                      {d.entrenamientos.map((e) => (
                        <li>
                          <Icon name="clock" size={16} /> {e.dia} · {e.horario}
                          <br />
                          <span class="muted"><Icon name="pin" size={14} /> {e.lugar}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="disc__block">
                    <p class="disc__label">Competencias</p>
                    <p class="disc__text">{d.competencias}</p>
                  </div>
                  <div class="card__footer">
                    <ActionButton
                      label={d.inscripcion.label}
                      href={d.inscripcion.href}
                      variant="outline"
                      size="sm"
                      block
                      pendingTag="Próximamente"
                      pendingMessage={`La inscripción a ${d.nombre} todavía no está habilitada. Consultá con el área de Deportes.`}
                    />
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <EmptyState icon="ball" title="Todavía no hay disciplinas cargadas" />
        )
      }
    </div>
  </section>

  <!-- Próximas actividades -->
  <section class="section section--sand" aria-labelledby="agenda-dep">
    <div class="container agenda">
      <div>
        <SectionHeader id="agenda-dep" eyebrow="Agenda deportiva" title="Próximas actividades" />
        <div class="insc" data-reveal>
          <h3 class="insc__title">Inscripción a los equipos</h3>
          <p class="muted">
            Espacio para explicar requisitos (ser alumno regular, apto físico, seguro), plazos y el procedimiento para sumarse a cada disciplina.
          </p>
          <ActionButton
            label="Formulario de inscripción"
            href={null}
            pendingTag="Próximamente"
            pendingMessage="El formulario de inscripción a deportes todavía no está habilitado."
          />
        </div>
      </div>
      <div>
        {
          proximas.length > 0 ? (
            <ol role="list" class="agenda__list" data-reveal-stagger>
              {proximas.map((a) => (
                <li class="agenda__item">
                  <DateStamp fecha={a.fecha} />
                  <div>
                    <p class="agenda__meta">
                      <span class="badge badge--navy">{a.disciplina}</span>
                      <span class="badge">{a.tipo}</span>
                      {a.ejemplo && <span class="badge badge--sample">Ejemplo</span>}
                    </p>
                    <h3 class="agenda__title">{a.titulo}</h3>
                    <p class="agenda__place">
                      {a.hora && <><Icon name="clock" size={15} /> {a.hora} h · </>}
                      <Icon name="pin" size={15} /> {a.lugar}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <EmptyState icon="calendar" title="Sin actividades programadas" text="Pronto publicaremos nuevas fechas." />
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .iu-banner {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--ivory);
    background:
      repeating-linear-gradient(-60deg, transparent 0 22px, rgb(255 255 255 / 0.025) 22px 23px),
      radial-gradient(ellipse 70% 120% at 100% 50%, rgb(184 149 92 / 0.35), transparent 60%),
      var(--navy-950);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .iu-banner:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  @media (min-width: 900px) { .iu-banner { grid-template-columns: 1fr auto; align-items: end; } }
  .iu-banner__text { display: flex; flex-direction: column; gap: 0.5rem; }
  .iu-banner__kicker { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-500); }
  .iu-banner__title { font-family: var(--font-sport); font-size: clamp(3.5rem, 2rem + 7vw, 7.5rem); line-height: 0.85; letter-spacing: 0.02em; }
  .iu-banner__lead { max-width: 48ch; color: #c9cfdd; }
  .iu-banner__stats { display: flex; gap: 2rem; font-size: var(--fs-sm); color: #c9cfdd; }
  .iu-banner__stats strong { display: block; font-family: var(--font-sport); font-size: 3rem; line-height: 1; color: var(--gold-500); font-weight: 400; }
  .iu-banner__cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; transition: gap var(--dur) var(--ease-out); }
  .iu-banner:hover .iu-banner__cta { gap: 1rem; }

  .disc__head { display: flex; align-items: center; gap: 0.9rem; padding: 1.25rem 1.5rem; background: var(--navy-900); color: var(--ivory); }
  .disc__head .badge { margin-left: auto; }
  .disc__icon { color: var(--gold-500); transition: transform 600ms var(--ease-out); }
  .disc:hover .disc__icon { transform: rotate(180deg); }
  .disc__name { font-family: var(--font-sport); font-size: 2rem; font-weight: 400; letter-spacing: 0.03em; line-height: 1; }
  .disc__label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-600); margin-bottom: 0.3rem; }
  .disc__list, .disc__text { font-size: var(--fs-sm); }
  .disc__list li { line-height: 1.7; }
  .disc__list :global(.icon) { display: inline; vertical-align: -2px; color: var(--gold-600); }

  .agenda { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .agenda { grid-template-columns: 1fr 1.3fr; gap: 4rem; } }
  .insc { padding: 1.75rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); }
  .insc > * + * { margin-top: 0.9rem; }
  .insc__title { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; }
  .agenda__list { display: grid; gap: 1rem; }
  .agenda__item { display: flex; gap: 1.25rem; align-items: center; padding: 1.25rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .agenda__item:hover { transform: translateX(4px); box-shadow: var(--shadow); }
  .agenda__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .agenda__title { margin-top: 0.5rem; font-family: var(--font-serif); font-size: 1.4rem; font-weight: 600; line-height: 1.15; }
  .agenda__place { margin-top: 0.25rem; font-size: var(--fs-sm); color: var(--ink-soft); }
  .agenda__place :global(.icon) { display: inline; vertical-align: -2px; color: var(--gold-600); }
</style>
