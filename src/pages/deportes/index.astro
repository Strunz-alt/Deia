---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import DateStamp from '@/components/DateStamp.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import SampleNotice from '@/components/SampleNotice.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { actividadesDeportivas, disciplinas } from '@/data/deportes';
import { site } from '@/data/site';
import { estadoEvento, porFechaAsc } from '@/lib/format';
import { resumenInteruca } from '@/lib/services/interuca';

const proximas = actividadesDeportivas.filter((a) => estadoEvento(a.fecha) === 'proxima').sort(porFechaAsc);
const resumen = await resumenInteruca();
---

<BaseLayout title="Deportes" description="Disciplinas, entrenamientos y competencias del Centro de Estudiantes de Derecho de la UCA.">
  <PageHero
    eyebrow="Deporte y comunidad"
    title="Deportes"
    lead="Entrenamos, competimos y representamos a la Facultad. Conocé las disciplinas, los horarios de entrenamiento y cómo sumarte a los equipos."
    crumbs={[{ label: 'Actividades' }]}
  />

  <!-- Acceso destacado INTERUCA -->
  <section class="section section--tight">
    <div class="container">
      <a href="/deportes/interuca" class="iu-banner" data-reveal>
        <div class="iu-banner__text">
          <span class="iu-banner__kicker"><Icon name="trophy" size={18} /> Historial de victorias · {site.hashtagInteruca}</span>
          <span class="iu-banner__title">INTERUCA</span>
          <span class="iu-banner__lead">Resultados, trofeos, fotos e hitos de cada edición, por año y disciplina.</span>
        </div>
        {
          resumen.participaciones > 0 && (
            <div class="iu-banner__stats" aria-hidden="true">
              <span><strong>{resumen.campeonatos}</strong> campeonatos</span>
              <span><strong>{resumen.ediciones}</strong> ediciones</span>
            </div>
          )
        }
        <span class="iu-banner__cta">Ver historial <Icon name="arrow" size={20} /></span>
      </a>
    </div>
  </section>

  <!-- Disciplinas -->
  <section class="section section--tight" aria-labelledby="disc-title">
    <div class="container">
      <SectionHeader
        id="disc-title"
        eyebrow="Disciplinas"
        title="Elegí tu deporte"
        lead="Entrenamientos semanales y competencias durante todo el año. Los horarios definitivos se publican al inicio de cada cuatrimestre."
      />
      <SampleNotice source="src/data/deportes.ts" text="Las disciplinas, horarios y actividades de esta página son de ejemplo: confirmar con el área de Deportes." />
      {
        disciplinas.length > 0 ? (
          <div class="grid grid--3" data-reveal-stagger>
            {disciplinas.map((d) => (
              <article class="card card--interactive disc" id={d.slug}>
                <div class="disc__head">
                  <span class="disc__icon"><Icon name="ball" size={24} /></span>
                  <h3 class="disc__name">{d.nombre}</h3>
                </div>
                <div class="card__body">
                  <div class="card__meta">
                    {d.ramas.map((r) => (
                      <span class="badge">{r}</span>
                    ))}
                  </div>
                  <div>
                    <p class="disc__label">Entrenamientos</p>
                    <ul role="list" class="disc__list">
                      {d.entrenamientos.map((e) => (
                        <li>
                          <Icon name="clock" size={15} /> {e.dia} · {e.horario} · {e.lugar}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="disc__label">Competencias</p>
                    <p class="disc__text">{d.competencias}</p>
                  </div>
                  <div class="card__footer">
                    <ActionButton
                      label={d.inscripcion.label}
                      href={d.inscripcion.href}
                      variant="outline"
                      size="sm"
                      block
                      pendingTag="Próximamente"
                      pendingMessage={`La inscripción a ${d.nombre} todavía no está habilitada. Consultá con el área de Deportes.`}
                    />
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <EmptyState icon="ball" title="Todavía no hay disciplinas cargadas" />
        )
      }
    </div>
  </section>

  <!-- Próximas actividades -->
  <section class="section section--sand" aria-labelledby="agenda-dep">
    <div class="container agenda">
      <div>
        <SectionHeader id="agenda-dep" eyebrow="Agenda deportiva" title="Próximas actividades" />
        <div class="insc" data-reveal>
          <h3 class="h3">Inscripción a los equipos</h3>
          <p class="muted">Requisitos (alumno regular, apto físico, seguro), plazos y procedimiento para sumarse a cada disciplina.</p>
          <ActionButton label="Formulario de inscripción" href={null} pendingTag="Próximamente" pendingMessage="El formulario de inscripción a deportes todavía no está habilitado." />
        </div>
      </div>
      <div>
        {
          proximas.length > 0 ? (
            <ol role="list" class="agenda__list" data-reveal-stagger>
              {proximas.map((a) => (
                <li class="agenda__item">
                  <DateStamp fecha={a.fecha} />
                  <div>
                    <p class="agenda__meta">
                      <span class="badge badge--red">{a.disciplina}</span>
                      <span class="badge">{a.tipo}</span>
                      {a.ejemplo && <span class="badge badge--sample">Ejemplo</span>}
                    </p>
                    <h3 class="agenda__title">{a.titulo}</h3>
                    <p class="agenda__place">
                      {a.hora && `${a.hora} h · `}
                      {a.lugar}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <EmptyState icon="calendar" title="Sin actividades programadas" text="Pronto publicaremos nuevas fechas." />
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .iu-banner {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--white);
    background: linear-gradient(110deg, var(--navy-700) 0 58%, var(--red-600) 58% 61%, var(--navy-800) 61%);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .iu-banner:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  @media (min-width: 900px) { .iu-banner { grid-template-columns: 1fr auto; align-items: end; } }
  .iu-banner__text { display: flex; flex-direction: column; gap: 0.5rem; }
  .iu-banner__kicker { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: #c8d3ee; }
  .iu-banner__title { font-family: var(--font-display); font-size: clamp(4rem, 2rem + 7vw, 8rem); line-height: 0.85; }
  .iu-banner__lead { max-width: 48ch; color: #dfe5f4; }
  .iu-banner__stats { display: flex; gap: 2rem; font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #dfe5f4; }
  .iu-banner__stats strong { display: block; font-family: var(--font-display); font-size: 3.2rem; line-height: 1; color: var(--white); font-weight: 400; letter-spacing: 0; }
  .iu-banner__cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; transition: gap var(--dur) var(--ease-out); }
  .iu-banner:hover .iu-banner__cta { gap: 1rem; }

  .disc__head { display: flex; align-items: center; gap: 0.9rem; padding: 1.1rem 1.4rem; background: var(--red-600); color: var(--white); }
  .disc__icon { transition: transform 600ms var(--ease-out); }
  .disc:hover .disc__icon { transform: rotate(180deg); }
  .disc__name { font-family: var(--font-display); font-size: 2.1rem; font-weight: 400; letter-spacing: 0.03em; line-height: 1; }
  .disc__label { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-600); margin-bottom: 0.3rem; }
  .disc__list, .disc__text { font-size: var(--fs-sm); }
  .disc__list li { display: flex; gap: 0.4rem; align-items: center; }
  .disc__list :global(.icon) { color: var(--red-600); flex: none; }

  .agenda { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .agenda { grid-template-columns: 1fr 1.3fr; gap: 4rem; } }
  .insc { padding: 1.75rem; background: var(--white); border: 1px solid var(--line); border-left: 5px solid var(--red-600); border-radius: var(--radius); }
  .insc > * + * { margin-top: 0.9rem; }
  .agenda__list { display: grid; gap: 1rem; }
  .agenda__item { display: flex; gap: 1.25rem; align-items: center; padding: 1.1rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .agenda__item:hover { transform: translateX(4px); box-shadow: var(--shadow); }
  .agenda__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .agenda__title { margin-top: 0.5rem; font-family: var(--font-cond); font-size: 1.3rem; font-weight: 500; line-height: 1.2; }
  .agenda__place { margin-top: 0.25rem; font-size: var(--fs-sm); color: var(--ink-soft); }
</style>
