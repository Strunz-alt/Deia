---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import FilterChips from '@/components/FilterChips.astro';
import MiembroCard from '@/components/MiembroCard.astro';
import PageHero from '@/components/PageHero.astro';
import { listMiembros } from '@/lib/services/miembros';

const miembros = await listMiembros();
// Áreas en el orden en que aparecen por primera vez en la lista definida en el panel.
const areas = [...new Set(miembros.map((m) => m.area).filter(Boolean))] as string[];
---

<BaseLayout title="Miembros del Centro" description="Conocé a quienes integran el Centro de Estudiantes de Derecho de la UCA.">
  <PageHero
    eyebrow="El Centro"
    title="Quiénes somos"
    lead="Somos estudiantes de distintos años de la carrera que trabajamos por una Facultad más cercana, participativa y comprometida."
    crumbs={[{ label: 'El Centro' }]}
  />

  <section class="section section--tight">
    <div class="container" data-filter-root data-filter-url="false">
      {
        miembros.length === 0 ? (
          <EmptyState icon="users" title="Pronto presentaremos al equipo" text="Estamos preparando los perfiles de quienes integran el Centro." />
        ) : (
          <>
            {areas.length > 1 && (
              <div class="team-filter" data-reveal>
                <FilterChips filterKey="area" label="Filtrar por área" allLabel="Todo el equipo" options={areas.map((a) => ({ value: a, label: a }))} />
                <p class="results-bar__count" data-filter-count data-one="integrante" data-many="integrantes" aria-live="polite"></p>
              </div>
            )}
            <div class="grid grid--4" data-reveal-stagger>
              {miembros.map((m) => (
                <MiembroCard miembro={m} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .team-filter { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
</style>
