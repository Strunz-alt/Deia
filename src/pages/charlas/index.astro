---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CharlaCard from '@/components/CharlaCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import FilterChips from '@/components/FilterChips.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { listCharlasRealizadas, listProximasCharlas } from '@/lib/services/charlas';

// Próximas primero (orden cronológico) y luego realizadas (más recientes primero).
const [proximas, realizadas] = await Promise.all([listProximasCharlas(), listCharlasRealizadas()]);
const ordenadas = [...proximas, ...realizadas];
const tipos = [...new Set(ordenadas.map((c) => c.tipo))];
---

<BaseLayout title="Charlas" description="Charlas, jornadas y encuentros organizados por el Centro de Estudiantes de Derecho de la UCA.">
  <PageHero
    eyebrow="Actividades académicas"
    title="Charlas y jornadas"
    lead="Espacios para aprender de especialistas, graduados y compañeros. Consultá la agenda, revisá actividades anteriores e inscribite."
    crumbs={[{ label: 'Actividades' }]}
  />

  <section class="section section--tight">
    <div class="container" data-filter-root>
      {
        ordenadas.length === 0 ? (
          <EmptyState icon="calendar" title="Todavía no hay charlas cargadas" text="Cuando se anuncien nuevas charlas y jornadas aparecerán acá." />
        ) : (
          <>
            <div class="toolbar" data-reveal>
              <div class="toolbar__search field">
                <label class="field__label" for="charlas-q">Buscar</label>
                <div class="input-icon">
                  <Icon name="search" size={18} />
                  <input id="charlas-q" class="input" type="search" placeholder="Título, temática, orador o lugar" data-filter-search />
                </div>
              </div>
              <div class="toolbar__group">
                <span class="field__label">Estado</span>
                <FilterChips
                  filterKey="estado"
                  label="Filtrar por estado"
                  options={[
                    { value: 'proxima', label: `Próximas (${proximas.length})` },
                    { value: 'realizada', label: `Realizadas (${realizadas.length})` },
                  ]}
                />
              </div>
              {tipos.length > 1 && (
                <div class="toolbar__group">
                  <span class="field__label">Formato</span>
                  <FilterChips filterKey="tipo" label="Filtrar por formato" allLabel="Todos" options={tipos.map((t) => ({ value: t, label: t }))} />
                </div>
              )}
            </div>

            <div class="results-bar">
              <p class="results-bar__count" data-filter-count data-one="actividad" data-many="actividades" aria-live="polite"></p>
              <button type="button" class="reset" data-filter-reset>Limpiar filtros</button>
            </div>

            <div class="grid grid--3" data-reveal-stagger>
              {ordenadas.map((c) => (
                <CharlaCard charla={c} headingLevel="h2" />
              ))}
            </div>
            <EmptyState filterEmpty icon="search" title="No encontramos actividades" text="Probá con otra búsqueda o limpiá los filtros para ver todas las actividades." />
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
