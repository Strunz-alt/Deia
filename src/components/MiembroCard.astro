---
import Icon from './Icon.astro';
import type { Miembro } from '@/db/schema';
import { mediaUrl } from '@/lib/storage';

interface Props {
  miembro: Miembro;
}

const { miembro } = Astro.props;
const foto = mediaUrl(miembro.foto);
---

<article class="card card--interactive miembro" data-filter-item data-f-area={miembro.area ?? ''} data-search={`${miembro.nombre} ${miembro.cargo} ${miembro.area ?? ''}`}>
  <div class="miembro__photo">
    {
      foto ? (
        <img src={foto} alt={`Foto de ${miembro.nombre}`} loading="lazy" decoding="async" />
      ) : (
        <div class="miembro__ph" aria-hidden="true">
          <Icon name="user" size={54} />
        </div>
      )
    }
    <span class="miembro__cargo">{miembro.cargo}</span>
  </div>
  <div class="miembro__body">
    {miembro.area && <p class="miembro__area">{miembro.area}</p>}
    <h3 class="miembro__name">{miembro.nombre}</h3>
    {miembro.descripcion && <p class="miembro__desc">{miembro.descripcion}</p>}
  </div>
</article>

<style>
  .miembro__photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--red-50); }
  .miembro__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .miembro:hover .miembro__photo img { transform: scale(1.05); }
  .miembro__ph {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--red-200);
    background: repeating-linear-gradient(-60deg, transparent 0 18px, rgb(171 23 23 / 0.06) 18px 19px), var(--red-50);
  }
  /* Cargo sobre una barra roja, como los textos de los flyers. */
  .miembro__cargo {
    position: absolute;
    left: 0;
    bottom: 1rem;
    max-width: calc(100% - 1rem);
    padding: 0.35rem 0.8rem 0.3rem 1rem;
    font-family: var(--font-cond);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--red-600);
    transition: padding var(--dur) var(--ease-out);
  }
  .miembro:hover .miembro__cargo { padding-left: 1.4rem; }
  .miembro__body { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.25rem 1.35rem; }
  .miembro__area { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red-600); }
  .miembro__name { font-family: var(--font-display); font-size: 1.9rem; font-weight: 400; line-height: 0.95; letter-spacing: 0.02em; text-transform: uppercase; }
  .miembro__desc { font-size: var(--fs-sm); color: var(--ink-soft); }
</style>
