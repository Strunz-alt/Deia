---
/**
 * Imagen de contenido. Si todavía no hay imagen cargada, muestra un marcador
 * con el escudo del Centro sobre la trama roja de la identidad.
 */
import Icon, { type IconName } from './Icon.astro';
import { mediaUrl } from '@/lib/storage';

interface Props {
  /** Clave de archivo subida desde el panel. */
  src?: string | null;
  alt?: string;
  label?: string;
  icon?: IconName;
  ratio?: string;
  tone?: 'light' | 'red' | 'dark';
  eager?: boolean;
  class?: string;
}

const { src, alt = '', label, icon, ratio = '16 / 10', tone = 'light', eager = false, class: className } = Astro.props;
const url = mediaUrl(src);
---

{
  url ? (
    <img src={url} alt={alt} class:list={['ph-img', className]} style={`aspect-ratio:${ratio}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class:list={['ph', `ph--${tone}`, className]} style={`aspect-ratio:${ratio}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <span class="ph__inner">
        {icon ? <Icon name={icon} size={30} /> : <img src="/brand/logo-ced-192.png" alt="" width="64" height="64" class="ph__seal" />}
      </span>
    </div>
  )
}

<style>
  .ph-img { width: 100%; object-fit: cover; background: var(--sand); }
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    color: var(--red-600);
    background-color: var(--red-50);
    background-image: repeating-linear-gradient(-60deg, transparent 0 18px, rgb(171 23 23 / 0.06) 18px 19px);
  }
  .ph--red {
    color: var(--white);
    background-color: var(--red-600);
    background-image: repeating-linear-gradient(-60deg, transparent 0 18px, rgb(0 0 0 / 0.08) 18px 19px);
  }
  .ph--dark {
    color: rgb(255 255 255 / 0.6);
    background-color: var(--red-900);
    background-image: repeating-linear-gradient(-60deg, transparent 0 18px, rgb(255 255 255 / 0.04) 18px 19px);
  }
  .ph__seal { width: 64px; height: 64px; opacity: 0.85; border-radius: 50%; }
  .ph--light .ph__seal { opacity: 0.55; }
</style>
