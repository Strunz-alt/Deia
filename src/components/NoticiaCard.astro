---
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import type { Noticia } from '@/data/types';
import { formatFecha } from '@/lib/format';

interface Props {
  noticia: Noticia;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { noticia, featured = false, headingLevel: H = 'h3' } = Astro.props;
---

<article
  class:list={['card card--interactive noticia-card', { 'noticia-card--featured': featured }]}
  data-filter-item
  data-f-categoria={noticia.categoria}
  data-search={`${noticia.titulo} ${noticia.bajada} ${noticia.categoria}`}
>
  <div class="noticia-card__media">
    <Placeholder image={noticia.imagen} icon="news" ratio={featured ? '16 / 11' : '16 / 9'} />
  </div>
  <div class="card__body">
    <div class="card__meta">
      <span class="badge badge--navy">{noticia.categoria}</span>
      {noticia.ejemplo && <span class="badge badge--sample">Ejemplo</span>}
      <time datetime={noticia.fecha} class="noticia-card__date">{formatFecha(noticia.fecha)}</time>
    </div>
    <H class="card__title">
      <a href={`/noticias/${noticia.slug}`} class="card__link">{noticia.titulo}</a>
    </H>
    <p class="muted noticia-card__bajada">{noticia.bajada}</p>
    <span class="card__footer link-arrow" aria-hidden="true">Leer más <Icon name="arrow" size={16} /></span>
  </div>
</article>

<style>
  .noticia-card__media { overflow: hidden; }
  .noticia-card__media :global(> *) { transition: transform 900ms var(--ease-out); }
  .noticia-card:hover .noticia-card__media :global(> *) { transform: scale(1.04); }
  .noticia-card__date { font-size: var(--fs-xs); color: var(--ink-faint); margin-left: auto; }
  .noticia-card__bajada { font-size: var(--fs-sm); }
  .noticia-card:hover :global(.card__footer) { gap: 0.85rem; }

  @media (min-width: 900px) {
    .noticia-card--featured { display: grid; grid-template-columns: 1.15fr 1fr; }
    .noticia-card--featured .noticia-card__media :global(> *) { height: 100%; }
    .noticia-card--featured .card__body { padding: 2.25rem; justify-content: center; }
    .noticia-card--featured .card__title { font-size: var(--fs-xl); }
    .noticia-card--featured .noticia-card__bajada { font-size: var(--fs-base); }
  }
</style>
