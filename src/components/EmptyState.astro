---
/**
 * Estado vacío: se muestra cuando todavía no hay información cargada
 * o cuando un filtro no devuelve resultados.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon?: IconName;
  title: string;
  text?: string;
  /** Para estados vacíos controlados por filtros. */
  filterEmpty?: boolean;
  compact?: boolean;
}

const { icon = 'hourglass', title, text, filterEmpty = false, compact = false } = Astro.props;
---

<div
  class:list={['empty', { 'empty--compact': compact }]}
  {...(filterEmpty ? { 'data-filter-empty': '', hidden: true } : {})}
  role={filterEmpty ? 'status' : undefined}
>
  <span class="empty__icon"><Icon name={icon} size={26} /></span>
  <p class="empty__title">{title}</p>
  {text && <p class="empty__text">{text}</p>}
  <slot />
</div>

<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: clamp(2.5rem, 2rem + 3vw, 4rem) 1.5rem;
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 0%, rgb(184 149 92 / 0.08), transparent 60%),
      var(--paper);
  }
  .empty--compact { padding: 2rem 1.25rem; }
  .empty__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    border: 1px solid var(--gold-200);
    color: var(--gold-600);
    background: var(--ivory);
  }
  .empty__title { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--navy-900); }
  .empty__text { max-width: 46ch; color: var(--ink-soft); font-size: var(--fs-sm); }
  .empty :global(.btn) { margin-top: 0.75rem; }
  :global(.section--dark) .empty { background: rgb(255 255 255 / 0.03); border-color: rgb(255 255 255 / 0.2); }
  :global(.section--dark) .empty__title { color: var(--ivory); }
  :global(.section--dark) .empty__text { color: #b9c1d4; }
  :global(.section--dark) .empty__icon { background: transparent; border-color: rgb(184 149 92 / 0.4); color: var(--gold-500); }
</style>
