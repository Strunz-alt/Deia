---
/** Sello de fecha estilo calendario (día grande + mes), como en los flyers. */
import { partesFecha } from '@/lib/format';

interface Props {
  fecha: string;
  tone?: 'light' | 'red';
  size?: 'md' | 'lg';
}

const { fecha, tone = 'light', size = 'md' } = Astro.props;
const p = partesFecha(fecha);
---

<time datetime={fecha} class:list={['stamp', `stamp--${tone}`, `stamp--${size}`]}>
  <span class="stamp__month">{p.mes}</span>
  <span class="stamp__day">{p.dia}</span>
  <span class="stamp__year">{p.anio}</span>
</time>

<style>
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 66px;
    border: 1.5px solid var(--line-strong);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
    color: var(--ink);
    line-height: 1;
    text-align: center;
  }
  .stamp__month {
    width: 100%;
    padding: 0.3rem 0.5rem 0.25rem;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--red-600);
    color: var(--white);
  }
  .stamp__day { padding-top: 0.35rem; font-family: var(--font-display); font-size: 2.1rem; }
  .stamp__year { padding: 0.1rem 0 0.4rem; font-size: 0.64rem; font-weight: 600; color: var(--ink-faint); }
  .stamp--red { border-color: var(--red-600); background: var(--red-600); color: var(--white); }
  .stamp--red .stamp__month { background: var(--red-900); }
  .stamp--red .stamp__year { color: #ffd2cd; }
  .stamp--lg { min-width: 92px; }
  .stamp--lg .stamp__day { font-size: 3rem; }
</style>
