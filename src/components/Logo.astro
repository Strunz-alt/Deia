---
/**
 * LOGO PROVISIONAL. Reemplazar el SVG por el isologo oficial del Centro
 * (por ejemplo, `<img src="/logo.svg" alt="" />`) cuando esté disponible.
 */
import { site } from '@/data/site';

interface Props {
  variant?: 'dark' | 'light';
  compact?: boolean;
}

const { variant = 'dark', compact = false } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, { 'logo--compact': compact }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22.5" fill="none" stroke="currentColor" stroke-width="1" opacity=".55"></circle>
    <circle cx="24" cy="24" r="19" fill="none" stroke="var(--gold-500)" stroke-width="1"></circle>
    <text x="24" y="29.5" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="15" font-weight="600" fill="currentColor" letter-spacing=".5">
      {site.sigla}
    </text>
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.nombre}</span>
    <span class="logo__inst">UCA · Facultad de Derecho</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--navy-900);
  }
  .logo--light { color: var(--ivory); }
  .logo__mark { width: 44px; height: 44px; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0.005em;
  }
  .logo__inst {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-top: 0.2rem;
  }
  @media (max-width: 420px) {
    .logo--compact .logo__name { font-size: 0.98rem; }
  }
</style>
