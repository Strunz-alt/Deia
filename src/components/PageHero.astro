---
/**
 * Encabezado de página interna: migas de pan, antetítulo, título y bajada.
 * `variant="dark"` para secciones con más protagonismo visual.
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  variant?: 'light' | 'dark';
  /** Numeral decorativo (p. ej. "II") que acompaña al título. */
  numeral?: string;
}

const { eyebrow, title, lead, crumbs = [], variant = 'light', numeral } = Astro.props;
const trail: Crumb[] = [{ label: 'Inicio', href: '/' }, ...crumbs];
---

<section class:list={['page-hero', `page-hero--${variant}`]}>
  <div class="container page-hero__inner">
    <nav aria-label="Migas de pan" class="crumbs">
      <ol role="list">
        {
          trail.map((c) => (
            <li>
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </li>
          ))
        }
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>
    <div class="page-hero__head">
      <div class="page-hero__text" data-reveal>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="h1 page-hero__title">{title}</h1>
        {lead && <p class="lead page-hero__lead">{lead}</p>}
        <slot />
      </div>
      {numeral && <span class="page-hero__numeral" aria-hidden="true">{numeral}</span>}
    </div>
  </div>
  <slot name="after" />
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .page-hero--dark {
    background: var(--navy-900);
    color: var(--ivory);
    border-bottom: 0;
    --color-muted: #b9c1d4;
    --color-accent-text: var(--gold-500);
  }
  /* Trama sutil de líneas, recurso gráfico de la identidad. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, currentColor 1px, transparent 1px);
    background-size: 120px 100%;
    opacity: 0.045;
    mask-image: linear-gradient(to left, #000 10%, transparent 75%);
    pointer-events: none;
  }
  .page-hero__inner { position: relative; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: var(--fs-xs); color: var(--color-muted); }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 0.35rem; opacity: 0.6; }
  .crumbs a { transition: color var(--dur-fast); }
  .crumbs a:hover { color: var(--color-accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { color: inherit; }

  .page-hero__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .page-hero__text > * + * { margin-top: 1rem; }
  .page-hero__title { max-width: 18ch; }
  .page-hero__lead { max-width: 58ch; }
  .page-hero__numeral {
    display: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(6rem, 4rem + 8vw, 12rem);
    line-height: 0.8;
    color: var(--gold-500);
    opacity: 0.35;
    user-select: none;
  }
  @media (min-width: 800px) {
    .page-hero__numeral { display: block; }
  }
</style>
