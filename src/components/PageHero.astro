---
/**
 * Encabezado de página interna: franja roja con diagonal, título condensado
 * y el escudo como marca de agua (recursos de las publicaciones del Centro).
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  /** `dark` usa el bordó profundo (páginas de detalle). */
  variant?: 'red' | 'dark';
}

const { eyebrow, title, lead, crumbs = [], variant = 'red' } = Astro.props;
const trail: Crumb[] = [{ label: 'Inicio', href: '/' }, ...crumbs];
---

<section class:list={['page-hero', `page-hero--${variant}`]}>
  <div class="page-hero__deco" aria-hidden="true">
    <span class="page-hero__band"></span>
    <img src="/brand/logo-ced.webp" alt="" width="420" height="420" class="page-hero__seal" loading="lazy" />
  </div>
  <div class="container page-hero__inner">
    <nav aria-label="Migas de pan" class="crumbs">
      <ol role="list">
        {trail.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>
    <div class="page-hero__text" data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h1 page-hero__title">{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
  </div>
  <slot name="after" />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.75rem, 1.25rem + 2vw, 2.75rem) clamp(3rem, 2rem + 4vw, 5rem);
    color: var(--white);
    background: var(--red-600);
    --color-muted: #f6d6d2;
    --color-accent-text: #ffe1dd;
  }
  .page-hero--dark { background: var(--red-950); --color-accent-text: #ff8f86; }
  .page-hero__deco { position: absolute; inset: 0; pointer-events: none; }
  .page-hero__band {
    position: absolute;
    inset: 0 -10% 0 auto;
    width: 55%;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.18), rgb(0 0 0 / 0.28));
    transform: skewX(-18deg);
    transform-origin: bottom;
  }
  .page-hero--dark .page-hero__band { background: linear-gradient(180deg, rgb(171 23 23 / 0.5), rgb(171 23 23 / 0.2)); }
  .page-hero__seal {
    position: absolute;
    right: clamp(-140px, -8vw, -40px);
    top: 50%;
    width: clamp(220px, 30vw, 420px);
    transform: translateY(-50%) rotate(-12deg);
    opacity: 0.12;
    filter: grayscale(1) brightness(4);
  }
  .page-hero__inner { position: relative; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.35rem; font-size: var(--fs-xs); font-weight: 600; color: var(--color-muted); }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 0.35rem; opacity: 0.6; }
  .crumbs a:hover { color: var(--white); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { color: var(--white); }
  .page-hero__text { margin-top: clamp(1.75rem, 1.25rem + 2.5vw, 3.25rem); max-width: 860px; }
  .page-hero__text > * + * { margin-top: 1rem; }
  .page-hero__title { text-shadow: 0 2px 0 rgb(0 0 0 / 0.12); }
  .page-hero__lead { max-width: 60ch; font-size: var(--fs-md); color: var(--color-muted); }
</style>
