---
interface Props {
  name: string;
  label: string;
  checked?: boolean;
  hint?: string;
}

const { name, label, checked = false, hint } = Astro.props;
const id = `f-${name}`;
---

<div class="check">
  <input type="checkbox" id={id} name={name} checked={checked} aria-describedby={hint ? `${id}-hint` : undefined} />
  <label for={id}>
    <span class="check__label">{label}</span>
    {hint && <span class="check__hint" id={`${id}-hint`}>{hint}</span>}
  </label>
</div>

<style>
  .check { display: flex; gap: 0.75rem; align-items: flex-start; }
  .check input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--red-600);
    cursor: pointer;
  }
  .check label { display: flex; flex-direction: column; cursor: pointer; }
  .check__label { font-weight: 600; font-size: var(--fs-sm); }
  .check__hint { font-size: var(--fs-xs); color: var(--ink-faint); }
</style>
