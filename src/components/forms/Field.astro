---
/** Campo de formulario con etiqueta, ayuda y error accesibles. */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'textarea' | 'date' | 'time' | 'url' | 'number' | 'email' | 'search';
  value?: string | number | null;
  error?: string;
  hint?: string;
  required?: boolean;
  maxlength?: number;
  rows?: number;
  placeholder?: string;
  min?: number | string;
  max?: number | string;
  list?: string;
  autocomplete?: import('astro/types').HTMLAttributes<'input'>['autocomplete'];
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  value,
  error,
  hint,
  required = false,
  maxlength,
  rows = 5,
  placeholder,
  min,
  max,
  list,
  autocomplete,
  class: className,
} = Astro.props;

const id = `f-${name}`;
const describedBy = [error && `${id}-error`, hint && `${id}-hint`].filter(Boolean).join(' ') || undefined;
const common = {
  id,
  name,
  required,
  placeholder,
  'aria-invalid': error ? ('true' as const) : undefined,
  'aria-describedby': describedBy,
};
---

<div class:list={['field', { 'field--invalid': error }, className]}>
  <label class="field__label" for={id}>
    {label}{required && <span class="req" aria-hidden="true">*</span>}
  </label>
  {
    type === 'textarea' ? (
      <textarea class="textarea" rows={rows} maxlength={maxlength} {...common}>{value ?? ''}</textarea>
    ) : (
      <input
        class="input"
        type={type}
        value={value ?? ''}
        maxlength={maxlength}
        min={min}
        max={max}
        list={list}
        autocomplete={autocomplete}
        {...common}
      />
    )
  }
  {hint && <p class="field__hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="field__error" id={`${id}-error`}>{error}</p>}
</div>
