---
/**
 * Galería de imágenes: agrega varias a la vez (con vista previa) y permite
 * marcar las existentes para quitarlas al guardar.
 */
import Icon from '../Icon.astro';
import { IMAGE_RULES, mediaUrl } from '@/lib/storage';

interface Props {
  name: string;
  label: string;
  existing?: { id: number; archivo: string }[];
  max: number;
  error?: string;
}

const { name, label, existing = [], max, error } = Astro.props;
const id = `f-${name}`;
const previewId = `${id}-preview`;
---

<div class:list={['field', 'images-field', { 'field--invalid': error }]}>
  <span class="field__label" id={`${id}-label`}>{label}</span>
  {
    existing.length > 0 && (
      <ul role="list" class="images-field__current">
        {existing.map((img) => (
          <li>
            <label class="images-field__item">
              <img src={mediaUrl(img.archivo)} alt="" />
              <span class="images-field__remove">
                <input type="checkbox" name="quitar_imagen" value={img.id} /> Quitar
              </span>
            </label>
          </li>
        ))}
      </ul>
    )
  }
  <div class="previews" id={previewId}></div>
  <label class="file-drop">
    <Icon name="upload" size={22} />
    <span class="file-drop__text">
      <strong>Agregar imágenes</strong>
      <span class="field__hint">Hasta {max} en total · {IMAGE_RULES.label} cada una</span>
      <span data-file-name></span>
    </span>
    <input
      type="file"
      id={id}
      name={name}
      multiple
      accept={IMAGE_RULES.accept}
      data-preview={previewId}
      data-max-bytes={IMAGE_RULES.maxBytes}
      data-max-files={Math.max(1, max - existing.length)}
      data-extensions="jpg,jpeg,png,webp"
      aria-labelledby={`${id}-label`}
      aria-describedby={error ? `${id}-error` : undefined}
    />
  </label>
  {error && <p class="field__error" id={`${id}-error`}>{error}</p>}
</div>

<style>
  .images-field__current { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .images-field__item { position: relative; display: block; width: 120px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); cursor: pointer; }
  .images-field__item img { width: 100%; aspect-ratio: 1; object-fit: cover; transition: opacity var(--dur-fast), filter var(--dur-fast); }
  .images-field__remove {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--red-700);
    background: var(--white);
  }
  .images-field__remove input { accent-color: var(--red-600); }
  .images-field__item:has(input:checked) img { opacity: 0.35; filter: grayscale(1); }
  .images-field__item:has(input:checked) { outline: 2px solid var(--red-600); }
</style>
