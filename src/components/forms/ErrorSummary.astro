---
/** Resumen de errores al principio del formulario, con enlaces a cada campo. */
import Icon from '../Icon.astro';
import type { FieldErrors } from '@/lib/forms';

interface Props {
  errors: FieldErrors;
  labels?: Record<string, string>;
  /** Recordatorio de volver a elegir archivos (el navegador los descarta al recargar). */
  fileNote?: boolean;
}

const { errors, labels = {}, fileNote = true } = Astro.props;
const entries = Object.entries(errors);
---

{
  entries.length > 0 && (
    <div class="notice notice--error error-summary" role="alert" tabindex="-1" data-error-summary>
      <Icon name="alert" size={20} />
      <div>
        <p>
          <strong>No se pudo guardar.</strong> Revisá {entries.length === 1 ? 'el campo marcado' : `los ${entries.length} campos marcados`}:
        </p>
        <ul>
          {entries.map(([k, msg]) => (
            <li>
              {k === '_form' ? msg : <a href={`#f-${k}`}>{labels[k] ? `${labels[k]}: ` : ''}{msg}</a>}
            </li>
          ))}
        </ul>
        {fileNote && <p class="error-summary__note">Si habías elegido un archivo, volvé a seleccionarlo antes de guardar.</p>}
      </div>
    </div>
  )
}

<style>
  .error-summary ul { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .error-summary a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .error-summary__note { margin-top: 0.4rem; font-size: var(--fs-xs); }
</style>

<script>
  document.querySelector<HTMLElement>('[data-error-summary]')?.focus();
</script>
