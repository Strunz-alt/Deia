{
  "name": "ced-uca-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio público del Centro de Estudiantes de Derecho de la UCA",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro check && astro build",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrar.ts",
    "db:demo": "node --env-file-if-exists=.env scripts/cargar-demo.ts",
    "admin": "node --env-file-if-exists=.env scripts/admin.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
